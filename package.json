  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@letele/playing-cards": "^0.1.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
