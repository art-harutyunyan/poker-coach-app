{
  "name": "poker-coach",
  "private": true,
  "version": "0.0.0-phase-0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
